# --- Required: ad analysis (Claude vision) ---
ANTHROPIC_API_KEY=
# Optional override; defaults to a current vision-capable Claude model.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Background image generation ---
# One of: pexels | mock | gemini | openai | flux
# `pexels` uses real stock photography (recommended). `mock` needs no key and
# returns a bundled placeholder so you can run the full pipeline immediately.
IMAGE_PROVIDER=pexels

# Real-photo provider key (free): https://www.pexels.com/api/
PEXELS_API_KEY=

# Generative provider keys (set the one matching IMAGE_PROVIDER)
GEMINI_API_KEY=
# Optional: override the Gemini image model (default gemini-2.5-flash-image).
# Higher quality: gemini-3-pro-image
GEMINI_IMAGE_MODEL=

# How the final ad is assembled:
#   ai      -> Nano Banana (Gemini) redraws text + logo onto the background (default)
#   overlay -> deterministic sharp/resvg compositing (lifts logos, re-renders text)
# `ai` requires GEMINI_API_KEY. Falls back to overlay if the key is missing.
COMPOSE_MODE=ai
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
