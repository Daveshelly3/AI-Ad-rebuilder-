# --- Required: ad analysis (Claude vision) ---
ANTHROPIC_API_KEY=
# Optional override; defaults to a current vision-capable Claude model.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Background image generation ---
# One of: mock | gemini | openai | flux
# `mock` needs no key and returns a bundled placeholder so you can run the full
# pipeline immediately. Switch to a real provider for photoreal backgrounds.
IMAGE_PROVIDER=mock

# Provider keys (set the one matching IMAGE_PROVIDER)
GEMINI_API_KEY=
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
